# Copy to .env.local and fill in. Leave the Supabase values empty to run in
# demo mode (mock data, live state synced between tabs of the same browser).

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The event row to show (matches supabase/seed.sql by default)
NEXT_PUBLIC_EVENT_ID=00000000-0000-0000-0000-000000000001
